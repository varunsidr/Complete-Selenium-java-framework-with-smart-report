<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Hybrid Framework Suite" verbose="1" thread-count="1">

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.SmokeTest"/>
            <class name="tests.FireInsuranceTest"/>
            <class name="tests.BrokenLinkCheckerTest"/>
            <class name="tests.NotesApiHealthCheckTest"/>
            <class name="tests.NotesApiLoginPostTest"/>
        </classes>
    </test>

</suite>
